# CNSTRCT runs with every value below empty.
# Copy to .env.local only when you want a live provider.

# LLM. XAI_API_KEY wins when both are set. Model calls fall back to the scripted demo model on failure.
XAI_API_KEY=
XAI_MODEL=grok-4.7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Orgo. Leave both empty and every computer stays not_configured.
# A live computer is Small: 0.5 vCPU, 4 GB RAM, 20 GB disk, one per agent.
# ORGO_WORKSPACE_ID is optional. With only ORGO_API_KEY the server creates one workspace per business.
# The app never calls Orgo secrets sync, so this key is not copied onto the VM.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=

# Composio. Leave empty and Gmail stays not_configured. Sends stay in the local outbox.
# Tenant id is biz_ plus the business id. Specialists use direct-tools sessions.
# The model list is Gmail fetch and draft. GMAIL_SEND_EMAIL runs only after approval.
# Do not set a NEXT_PUBLIC_ copy of this key.
COMPOSIO_API_KEY=

# Optional magic-link auth. Without these, the app keeps a demo session cookie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for canonical URLs and magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sqlite and sandboxes live here. Defaults to ./data
CNSTRCT_DATA_DIR=
