# BizOS (CNSTRCT repo) runs with every value below empty.
# Copy to .env.local only when you want a live provider.

# LLM. XAI_API_KEY wins when both are set. Model calls fall back to the scripted demo model on failure.
XAI_API_KEY=
XAI_MODEL=grok-4.7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Orgo. Leave empty and every desk stays not_connected until the provisioning worker runs.
# Each business gets workspace cnstrct-<business id> and one Linux computer named desk (2 vCPU, 8 GB RAM).
# Specialists shell into that shared desk VM. The orchestrator does not get a separate computer.
# The app never calls Orgo secrets sync, so this key is not copied onto the VM.
ORGO_API_KEY=

# Composio. This MVP does not send Gmail, even if this key is set.
# Approved drafts stay in the local outbox with network false. The UI does not list Gmail tools.
# A later send would use tenant id biz_ plus the business id. Do not set a NEXT_PUBLIC_ copy of this key.
COMPOSIO_API_KEY=

# Treg prospecting. Server-only. One BizOS team; each business uses customer tag biz_<businessId>.
TREG_TOKEN=
TREG_ORG_ID=

# Vercel Cron calls GET /api/cron/provisioning with Authorization: Bearer <secret>.
CRON_SECRET=

# Optional when Composio webhooks are wired.
# COMPOSIO_WEBHOOK_SECRET=

# Optional magic-link auth. Without these, the app keeps a demo session cookie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for canonical URLs and magic-link redirects.
# Local default below. Production (Vercel): https://cnstrct-mu.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable state. Production on Vercel requires DATABASE_URL or POSTGRES_URL and refuses SQLite.
# Use the Neon connection string from the Vercel Postgres / Neon integration. Pooled is fine.
# The HTTP driver reads the host and password from this string. Never commit a real URL.
DATABASE_URL=
POSTGRES_URL=

# Optional explicit driver. sqlite is local and test only (refused on Vercel). postgres requires a URL above.
# Tests ignore DATABASE_URL unless CNSTRCT_DB=postgres.
# CNSTRCT_DB=

# Optional. Local SQLite file lives here. Defaults to ./data. Production does not store application state here.
# Do not set this to /tmp in production.
CNSTRCT_DATA_DIR=

# Optional scratch folder for local computer sandboxes. Vercel uses /tmp/cnstrct-sandboxes when this is empty.
# That folder is not the database and does not survive a cold start.
# CNSTRCT_SANDBOX_DIR=

# Stripe billing. Secret key plus all three price IDs must be set to enable Checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_WEBHOOK_SECRET=

# Optional. When Stripe is configured, bypass skips paywall on non-production only.
# While Stripe keys are missing, construction stays open everywhere (launch mode).
# BILLING_MODE=enforce
# BILLING_MODE=bypass

# Test-only (node:test). Never set in production.
# BILLING_TEST_MODE=true
