# CNSTRCT runs with every value below empty.
# Copy to .env.local only when you want a live provider.

# LLM. XAI_API_KEY wins when both are set. Model calls fall back to the scripted demo model on failure.
XAI_API_KEY=
XAI_MODEL=grok-4.7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Orgo. Leave this empty and every computer stays not_configured.
# A live desk gets one workspace named cnstrct-<business id>, isolated from other businesses.
# Specialists get one Small computer each (0.5 vCPU, 4 GB RAM, 20 GB disk). Quinn does not.
# Two Small machines are 8 GB, which fits an Orgo Starter plan. Do not share ORGO_WORKSPACE_ID across businesses.
# The app never calls Orgo secrets sync, so this key is not copied onto the VM.
ORGO_API_KEY=

# Composio. This MVP does not send Gmail, even if this key is set.
# Approved drafts stay in the local outbox with network false. The UI does not list Gmail tools.
# A later send would use tenant id biz_ plus the business id. Do not set a NEXT_PUBLIC_ copy of this key.
COMPOSIO_API_KEY=

# Optional magic-link auth. Without these, the app keeps a demo session cookie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used for canonical URLs and magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sqlite and sandboxes live here. Defaults to ./data
CNSTRCT_DATA_DIR=

# Stripe billing. All three price-related values must be set to enable Checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Non-production only. bypass = construct without Stripe (ignored on Vercel production).
# If unset: bypass when Stripe keys are missing (local/preview), else enforce.
# BILLING_MODE=enforce
# BILLING_MODE=bypass

# Test-only (node:test). Never set in production.
# BILLING_TEST_MODE=true
